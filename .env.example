# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
# Options: sqlite | pg | mysql
# DB_CONNECTION=sqlite

# PostgreSQL / MySQL Configuration (Required when DB_CONNECTION=pg or mysql)
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=adonisjs7

# SQLite Configuration (Used when DB_CONNECTION=sqlite)
# SQLite 會預設儲存於本地檔案 tmp/db.sqlite3，無需設定 DB_HOST / DB_PORT / DB_USER / DB_PASSWORD